[Unit]
Description=Detect Box ROS detection service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/liujun/detect_box_ws
Environment=HOME=/home/user
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=21
Environment=ROS_LOCALHOST_ONLY=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ExecStartPre=/bin/sleep 5
ExecStart=/home/user/liujun/detect_box_ws/scripts/start_ros_nodes.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
