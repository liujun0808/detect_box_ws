# 发布镜像版本。升级时改为新的明确版本标签，例如 v0.1.1。
DETECT_BOX_SIM_IMAGE=registry.cn-hangzhou.aliyuncs.com/keno/qi-carry-box-sim:v0.1.0

# 私有阿里云镜像仓库的自动拉取账号。
# 本模板不保存密码；交付给同事的实际 .env 由发布方单独提供。
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_USERNAME=694407146@qq.com
ACR_PASSWORD=

# 必须与仿真相机发布节点和 /detect 服务调用方一致。
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0

# 保持 ROS 2 Humble 的默认 Fast DDS。
# 容器侧使用 UDP，避免 Docker 边界上的共享内存传输问题。
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
