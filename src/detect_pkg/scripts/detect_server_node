#!/usr/bin/env bash
set -e

DETECT_BOX_PYTHON="${DETECT_BOX_PYTHON:-/home/user/miniforge3/envs/detect_box/bin/python}"

if [[ ! -x "${DETECT_BOX_PYTHON}" ]]; then
  echo "Python executable not found: ${DETECT_BOX_PYTHON}" >&2
  exit 1
fi

exec "${DETECT_BOX_PYTHON}" -m detect_box_pipeline.detect_server_node "$@"
